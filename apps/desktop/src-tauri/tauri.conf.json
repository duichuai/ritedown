{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ritedown",
  "version": "2.1.0",
  "identifier": "com.duichuai.ritedown",
  "build": {
    "beforeDevCommand": "pnpm --dir ../editor dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ritedown",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
