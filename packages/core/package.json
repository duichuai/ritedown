{
  "name": "@ritedown/core",
  "version": "2.0.0-beta.1",
  "description": "Ritedown kernel: Markdown parse & render pipeline (CommonMark 0.31.2 based, pluggable extensions)",
  "license": "MIT",
  "author": "duichuai",
  "homepage": "https://duichuai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duichuai/ritedown.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/duichuai/ritedown/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@ritedown/gfm-alerts": "workspace:*",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
